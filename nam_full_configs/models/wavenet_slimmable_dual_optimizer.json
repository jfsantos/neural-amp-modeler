{
    "_notes": [
        "Slimmable WaveNet with phased dual-optimizer training.",
        "Phase 1: train only the small model until its loss plateaus.",
        "Phase 2: freeze small model, train only the large model.",
        "freeze_small.patience: epochs without improvement before freezing.",
        "freeze_small.after_epoch: hard cutoff (whichever triggers first).",
        "optimizer_small: separate optimizer for the small model phase."
    ],
    "net": {
        "name": "WaveNet",
        "config": {
            "layers_configs": [
                {
                    "condition_size": 1,
                    "input_size": 1,
                    "channels": 12,
                    "head_size": 1,
                    "kernel_size": 6,
                    "dilations": [
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227
                    ],
                    "activation": "LeakyReLU",
                    "head_bias": true,
                    "slimmable": {
                        "method": "slice_channels_uniform",
                        "kwargs": {
                            "allowed_channels": [
                                3,
                                12
                            ],
                            "boosting": true,
                            "init_strategy": "smallest_and_zeros"
                        }
                    }
                }
            ],
            "head_scale": 0.01
        }
    },
    "optimizer": {
        "lr": 0.004
    },
    "optimizer_small": {
        "lr": 0.002
    },
    "freeze_small": 100,
    "lr_scheduler": {
        "class": "ExponentialLR",
        "kwargs": {
            "gamma": 0.993
        }
    }
}
